class PassengerCheckIn extends Thread {
    int delay;

    PassengerCheckIn(int delay) {
        this.delay = delay;
    }

    @Override
    public void run() {
        try {
            System.out.println(Thread.currentThread().getName() + "- Started");
            sleep(delay);
            System.out.println(Thread.currentThread().getName() + "- Completed");
        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }
}

